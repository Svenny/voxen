	options: [
		{
			name: "use_debugging",
			comment: "Whether to enable graphics API debugging extensions\n\
(debug callbacks, object naming, cmdstream labels etc.)",
			type: "bool",
			default: false
		},
		{
			name: "use_validation",
			comment: "Whether to enable validation layers for graphics API",
			type: "bool",
			default: false
		},
		{
			name: "preferred_gpu_name",
			comment: "Name of the preferred GPU (as exposed by graphics API driver).\n\
If the name is empty or is not available then GPU will be auto-selected.",
			type: "string",
			default: ""
		},
	],
}
